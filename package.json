{
  "name": "slideify",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "jest --config jest.config.js --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "db:generate": "pnpm --filter @slideify/schema db:generate",
    "db:push": "pnpm --filter @slideify/schema db:push",
    "worker": "pnpm --filter worker start"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "bcryptjs": "^3.0.3",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
